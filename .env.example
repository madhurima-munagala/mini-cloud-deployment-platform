# Copy this file to .env and fill in real local values.
# .env itself must never be committed (see .gitignore).

# PostgreSQL connection string used by the application and by Alembic migrations.
DATABASE_URL=postgresql+psycopg2://replace-with-username:replace-with-password@localhost:5432/mini_cloud_platform

# Optional: separate database for the test suite, so tests never touch your
# real local data. Falls back to DATABASE_URL if left unset.
TEST_DATABASE_URL=postgresql+psycopg2://replace-with-username:replace-with-password@localhost:5432/mini_cloud_platform_test

# Fernet symmetric key used to encrypt/decrypt environment_variables.value_encrypted.
# Generate one locally with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Optional: set to true to log raw SQL locally for debugging (keep false elsewhere).
SQL_ECHO=false

# --- Stage 2 (FastAPI foundation) — all optional, safe to leave unset ---

# Optional: environment label, informational only.
ENVIRONMENT=development

# Optional: only needed if you want to change the API prefix from /api/v1.
API_V1_PREFIX=/api/v1

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave empty/unset to disable CORS middleware entirely (default).
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- Stage 3 (GitHub OAuth + sessions) ---

# Required to actually use the GitHub login flow (the endpoints return
# a 500 CONFIGURATION_ERROR if these are unset, rather than failing app
# startup) — create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Optional — defaults shown
GITHUB_OAUTH_SCOPE=public_repo read:user
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800
OAUTH_STATE_COOKIE_NAME=oauth_state
OAUTH_STATE_TTL_SECONDS=600

# --- Stage 6 (deployment engine integration) ---

# Required to actually trigger deployments and accept engine callbacks
# (the endpoints return 500 CONFIGURATION_ERROR if unset, rather than
# failing app startup) — coordinate these values with Sreelekha.
ENGINE_BASE_URL=
INTERNAL_API_TOKEN=

# This backend's own publicly-reachable base URL, given to the engine so
# it knows where to send callbacks.
BACKEND_BASE_URL=http://localhost:8000
